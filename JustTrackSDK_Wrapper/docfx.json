{
    "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
    "metadata": [
      {
        "src": [
          {
            "src": "./Assets/JustTrack/Runtime",
            "files": [
              "**/*.cs"
            ],
            "exclude": [
              "**/bin/**",
              "**/obj/**",
              "**/JustTrackSettings.cs",
              "**/SDKBaseAgent.cs",
              "**/Reflection.cs",
              "**/JustTrackBuildSettings.cs",
              "**/JustTrackSDKBehaviour.cs"
            ]
          }
        ],
        "dest": "api",
        "disableGitFeatures": false,
        "disableDefaultFilter": false
      }
    ],
    "build": {
      "content": [
        {
          "files": [
            "api/**.yml",
            "api/index.md"
          ]
        },
        {
          "files": [
            "articles/**.md",
            "articles/**/toc.yml",
            "toc.yml",
            "*.md"
          ]
        }
      ],
      "resource": [
        {
          "files": [
            "images/**"
          ]
        }
      ],
      "overwrite": [
        {
          "files": [
            "apidoc/**.md"
          ],
          "exclude": [
            "obj/**",
            "_site/**"
          ]
        }
      ],
      "globalMetadataFiles": [],
      "fileMetadataFiles": [],
      "template": [
        "default",
        "modern"
      ],
      "postProcessors": [],
      "disableGitFeatures": false,
      "globalMetadata": {
        "_appName": "justtrack SDK",
        "_appTitle": "justtrack Docs",
        "_enableSearch": true
      }
    }
  }